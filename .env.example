# Example environment variables for local development
# Copy this to .env and fill in your test/development keys
# 
# ⚠️ SECURITY IMPORTANT:
# - NEVER commit your .env file with real secrets
# - Use test/development credentials only (sk_test_*, pk_test_*)
# - For production, use Google Cloud Secret Manager (see docs/SECRETS_MANAGEMENT.md)

# Flask Configuration
SECRET_KEY=dev-secret-change-me-generate-with-secrets-token-urlsafe
FLASK_ENV=development
PORT=5001

# Stripe Test Keys (get from https://dashboard.stripe.com/test/apikeys)
# IMPORTANT: Use ONLY test keys (sk_test_* and pk_test_*) in local development
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME_WITH_TEST_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_ME_WITH_TEST_KEY
STRIPE_TEST_PRICE_ID=price_REPLACE_ME_WITH_TEST_PRICE_ID
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME_WITH_TEST_WEBHOOK_SECRET

# Stripe URLs (for local development)
STRIPE_SUCCESS_URL=http://localhost:5001/
STRIPE_CANCEL_URL=http://localhost:5001/

# Development Settings
ALLOW_DEV_DEBUG=1
DEV_ADMIN_PW=OHsj1984

# Admin Configuration
ADMIN_EMAILS=you@example.com

# Optional: OpenAI API Key (for content generation features)
# Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY

# Optional: Google Cloud Project ID (if using Secret Manager in dev)
# GCP_PROJECT_ID=your-project-id
# USE_SECRET_MANAGER=0  # Set to 1 to use Secret Manager even in dev

# Security Notes:
# 1. This file (.env) is already in .gitignore - DO NOT remove it from there
# 2. Never share your .env file with others
# 3. Use different secrets for each environment (dev, staging, production)
# 4. Rotate secrets regularly (see docs/SECRETS_ROTATION_RUNBOOK.md)
# 5. For production secrets, see docs/SECRETS_MANAGEMENT.md