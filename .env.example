### Example environment variables for local development
# Copy this file to `.env` and fill in values. Do NOT commit real secrets.

# Application
SECRET_KEY=dev-secret-change-me
FLASK_ENV=development

# Optional OpenAI (leave blank to use local fallback generator)
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-4o-mini

# Stripe (for local testing, provide test keys)
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# STRIPE_TEST_PRICE_ID=price_XXXX

# Webhook secret placeholder (use only if you configure webhook signing)
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Admin emails for protected endpoints (comma-separated)
# ADMIN_EMAILS=

# Reels quota per month (integer)
# REELS_QUOTA_MONTHLY=30

# Dev helper password for seeded admin (local only)
# DEV_ADMIN_PW=OHsj1984
# Example environment variables for local development
# Copy this to .env and fill in your Stripe test keys and webhook secret.
SECRET_KEY=dev-secret-change-me
FLASK_ENV=development
PORT=5001
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_TEST_PRICE_ID=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_SUCCESS_URL=http://localhost:5001/
STRIPE_CANCEL_URL=http://localhost:5001/
ALLOW_DEV_DEBUG=1
DEV_ADMIN_PW=OHsj1984
ADMIN_EMAILS=you@example.com

# Notes:
# - Do NOT commit a real .env file with secrets. Use this file as a template.