{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IndustryPack",
  "description": "Schema for industry-specific content generation packs",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "primary_customer_goal",
    "version",
    "business_profile_fields",
    "default_channel_strategy",
    "keyword_banks",
    "cta_library",
    "compliance_safety_rules",
    "content_templates",
    "example_outputs",
    "prompt_integration_hooks",
    "good_defaults"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the industry pack",
      "pattern": "^[a-z_]+$"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name for the industry"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon representing the industry"
    },
    "primary_customer_goal": {
      "type": "string",
      "enum": ["bookings", "memberships", "recurring_clients", "sales", "leads"],
      "description": "Primary business goal for this industry"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this industry pack"
    },
    "business_profile_fields": {
      "type": "object",
      "required": ["required", "optional", "example_values"],
      "properties": {
        "required": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Required profile fields for this industry"
        },
        "optional": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional profile fields"
        },
        "example_values": {
          "type": "object",
          "description": "Example values for wizard hints"
        }
      }
    },
    "default_channel_strategy": {
      "type": "object",
      "required": ["default_platforms", "content_cadence", "best_performing_types"],
      "properties": {
        "default_platforms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "content_cadence": {
          "type": "string"
        },
        "best_performing_types": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "keyword_banks": {
      "type": "object",
      "required": ["seed_keywords", "topic_clusters", "seasonal_hooks"],
      "properties": {
        "seed_keywords": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 10
        },
        "topic_clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "intent", "examples"],
            "properties": {
              "name": {"type": "string"},
              "intent": {
                "type": "string",
                "enum": ["awareness", "conversion", "retention"]
              },
              "examples": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "seasonal_hooks": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "cta_library": {
      "type": "object",
      "required": ["booking_ctas", "inquiry_ctas", "review_referral_ctas", "offer_ctas"],
      "properties": {
        "booking_ctas": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 3
        },
        "inquiry_ctas": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 3
        },
        "review_referral_ctas": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 3
        },
        "offer_ctas": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 3
        }
      }
    },
    "compliance_safety_rules": {
      "type": "object",
      "required": ["forbidden_claims", "privacy_constraints", "regulated_language_notes", "do_not_generate"],
      "properties": {
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "privacy_constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "regulated_language_notes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "do_not_generate": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "content_templates": {
      "type": "object",
      "required": ["social_templates", "email_templates", "review_reply_guidelines"],
      "properties": {
        "social_templates": {
          "type": "object",
          "required": ["post_structures", "reel_structures", "content_angles"],
          "properties": {
            "post_structures": {
              "type": "array",
              "items": {"type": "string"}
            },
            "reel_structures": {
              "type": "array",
              "items": {"type": "string"}
            },
            "content_angles": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "email_templates": {
          "type": "object",
          "required": ["scenarios"],
          "properties": {
            "scenarios": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "required_fields", "recommended_tone", "constraints", "suggested_cta"]
              }
            }
          }
        },
        "quote_scaffolds": {
          "type": "object",
          "properties": {
            "applicable": {"type": "boolean"},
            "quote_line_item_categories": {
              "type": "array",
              "items": {"type": "string"}
            },
            "assumptions_defaults": {
              "type": "array",
              "items": {"type": "string"}
            },
            "warranty_policy_boilerplate": {"type": "string"}
          }
        },
        "review_reply_guidelines": {
          "type": "object",
          "required": ["channel_specific", "empathy_patterns", "compliance_notes"],
          "properties": {
            "channel_specific": {"type": "object"},
            "empathy_patterns": {
              "type": "array",
              "items": {"type": "string"}
            },
            "compliance_notes": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "example_outputs": {
      "type": "object",
      "required": ["social_post", "reel_script", "email", "review_reply"],
      "properties": {
        "social_post": {"type": "object"},
        "reel_script": {"type": "object"},
        "email": {"type": "object"},
        "review_reply": {"type": "object"}
      }
    },
    "prompt_integration_hooks": {
      "type": "object",
      "required": ["industry_pack_id", "constraints_for_model", "default_do_dont_list"],
      "properties": {
        "industry_pack_id": {"type": "string"},
        "constraints_for_model": {
          "type": "array",
          "items": {"type": "string"}
        },
        "default_do_dont_list": {
          "type": "object",
          "required": ["do", "dont"],
          "properties": {
            "do": {
              "type": "array",
              "items": {"type": "string"}
            },
            "dont": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "good_defaults": {
      "type": "object",
      "description": "GOOD defaults for industry-specific chip presets and natural outputs",
      "required": ["audience", "offers", "proof", "content_angles", "do_say", "dont_say", "chip_presets"],
      "properties": {
        "audience": {
          "type": "object",
          "required": ["who", "pain_points", "desired_outcomes"],
          "properties": {
            "who": {
              "type": "string",
              "description": "Plain English description of target audience"
            },
            "pain_points": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 3,
              "maxItems": 5,
              "description": "3-5 key pain points"
            },
            "desired_outcomes": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 3,
              "maxItems": 5,
              "description": "3-5 desired outcomes"
            }
          }
        },
        "offers": {
          "type": "object",
          "required": ["common_services", "ctas"],
          "properties": {
            "common_services": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 5,
              "maxItems": 8,
              "description": "5-8 common services"
            },
            "ctas": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 4,
              "maxItems": 6,
              "description": "4-6 varied CTAs"
            }
          }
        },
        "proof": {
          "type": "object",
          "required": ["common_proof_points"],
          "properties": {
            "common_proof_points": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 4,
              "maxItems": 6,
              "description": "4-6 safe, non-claims-y proof points"
            }
          }
        },
        "content_angles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "when_to_use"],
            "properties": {
              "key": {"type": "string"},
              "label": {"type": "string"},
              "when_to_use": {"type": "string"}
            }
          },
          "minItems": 6,
          "maxItems": 8,
          "description": "6-8 angles that feel natural for that industry"
        },
        "do_say": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Sound like this - positive examples"
        },
        "dont_say": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Blocks generic or risky language"
        },
        "chip_presets": {
          "type": "object",
          "required": ["focus_topics", "audience_chips", "offer_chips", "proof_chips"],
          "properties": {
            "focus_topics": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                      "label": {"type": "string"}
                    }
                  }
                ]
              },
              "minItems": 8,
              "maxItems": 12,
              "description": "8-12 chips shown by default (string or {id, label} object)"
            },
            "audience_chips": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                      "label": {"type": "string"}
                    }
                  }
                ]
              },
              "minItems": 6,
              "maxItems": 10,
              "description": "6-10 audience chips (string or {id, label} object)"
            },
            "offer_chips": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                      "label": {"type": "string"}
                    }
                  }
                ]
              },
              "minItems": 6,
              "maxItems": 10,
              "description": "6-10 offer chips (string or {id, label} object)"
            },
            "proof_chips": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                      "label": {"type": "string"}
                    }
                  }
                ]
              },
              "minItems": 6,
              "maxItems": 10,
              "description": "6-10 proof chips (string or {id, label} object)"
            }
          }
        }
      }
    }
  }
}
