# Dockerignore file to exclude unnecessary files from the Docker build context

# Version control
.git
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
ENV/

# Environment variables (never include in image!)
.env
.env.*
*.env

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed at runtime)
docs/
*.md
!README.md

# Tests
tests/
test_*.py
pytest.ini
.pytest_cache/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Mac
.DS_Store

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Scripts not needed in production
scripts/
